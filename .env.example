# Database
DATABASE_URL=postgresql+psycopg2://airflow:airflow@postgres/airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Logging
LOG_LEVEL=INFO

# Email alerts (leave empty to disable)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Pipeline schedule
SCHEDULE_INTERVAL=0 * * * *
AQI_ALERT_THRESHOLD=40

# Airflow security (REQUIRED - generate your own)
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Airflow web UI credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin